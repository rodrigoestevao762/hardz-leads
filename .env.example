# HardZ Leads — variáveis de ambiente
# Copie para .env.local e preencha.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (https://aistudio.google.com — chave grátis)
GEMINI_API_KEY=

# Resend (https://resend.com — plano grátis 100 e-mails/dia)
RESEND_API_KEY=
# remetente padrão (usar domínio verificado no Resend, ex: leads@hardzsites.com)
RESEND_FROM=

# URL do site (para callback OAuth do Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
